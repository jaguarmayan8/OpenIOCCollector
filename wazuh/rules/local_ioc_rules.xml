    <list field="domain" lookup="address_match_key">etc/lists/malicious-domains</list>
    <description>DNS lookup of known malicious domain $(domain) (IOC feed)</description>
    <mitre><id>T1071.004</id></mitre>
  </rule>
  <rule id="100102" level="12">
    <decoded_as>json</decoded_as>
    <list field="query" lookup="address_match_key">etc/lists/malicious-domains</list>
