<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,threat_intel,">
  <rule id="100100" level="12">
    <if_sid>5760</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/malicious-ips</list>
    <description>SSH authentication failure from known malicious IP (IOC feed)</description>
    <mitre>
      <id>T1110</id>
      <id>T1071</id>
    </mitre>
  </rule>
</group>

<group name="local,threat_intel,">
  <rule id="100110" level="12">
    <if_sid>550,554</if_sid>
    <list field="md5" lookup="match_key">etc/lists/malicious-hashes</list>
    <description>File with known malicious MD5 hash detected (IOC feed)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <rule id="100111" level="12">
    <if_sid>550,554</if_sid>
    <list field="sha256" lookup="match_key">etc/lists/malicious-hashes</list>
    <description>File with known malicious SHA256 hash detected (IOC feed)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>
</group>

<group name="local,lab,recon,">
  <rule id="100200" level="6">
    <match>LAB_NMAP start</match>
    <description>Lab: nmap recon command executed</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>
